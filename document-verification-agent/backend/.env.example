# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Path to Poppler binaries (required for PDF → image conversion on Windows)
# Example: C:\Release-26.02.0-0\poppler-26.02.0\Library\bin
POPPLER_PATH=

# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=
